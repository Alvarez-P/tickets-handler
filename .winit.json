{
  "layout": 2,
  "name": "tickets-handler",
  "architecture": "ddd",
  "framework": "nestjs",
  "protocols": [
    "rest",
    "graphql",
    "events"
  ],
  "packageManager": "pnpm",
  "runtime": "ts-node-dev",
  "database": "postgres",
  "orm": "drizzle",
  "broker": "kafka",
  "docker": true,
  "aws": false,
  "cqrs": true,
  "search": "elasticsearch",
  "cache": "redis",
  "observability": [
    "otel"
  ],
  "outbox": true,
  "rateLimit": true,
  "tenancy": false,
  "auth": "jwt",
  "testTypes": [
    "unit",
    "e2e"
  ],
  "testRunner": "vitest",
  "linter": "oxlint"
}
