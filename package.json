{
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@elastic/elasticsearch": "9.5.1",
    "@nestjs/apollo": "14.0.3",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/cqrs": "12.1.1",
    "@nestjs/graphql": "14.0.3",
    "@nestjs/passport": "12.0.1",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.1.1",
    "@nestjs/throttler": "6.7.1",
    "@opentelemetry/auto-instrumentations-node": "0.82.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "graphql": "17.0.2",
    "ioredis": "6.0.0",
    "jose": "6.2.13",
    "kafkajs": "2.2.4",
    "nodemailer": "10.4.0",
    "passport": "0.7.0",
    "passport-local": "1.0.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.2.0",
    "@swc/core": "1.16.20",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/passport-local": "1.0.38",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "husky": "9.1.7",
    "oxlint": "1.89.0",
    "supertest": "7.3.1",
    "ts-node-dev": "2.0.0",
    "typescript": "5.9.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12"
  },
  "name": "tickets-handler",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "dev": "ts-node-dev --respawn src/main.ts",
    "dev:worker": "ts-node-dev --respawn src/worker.ts",
    "lint": "oxlint src test",
    "prepare": "husky",
    "reindex:tickets": "ts-node-dev --transpile-only src/scripts/reindex-tickets.ts",
    "seed:admin": "ts-node-dev --transpile-only src/scripts/seed-admin.ts",
    "start": "node dist/main.js",
    "test": "vitest run test/unit test/e2e",
    "test:e2e": "vitest run test/e2e",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:unit": "vitest run test/unit",
    "typecheck": "tsc --noEmit",
    "validate": "tsc --noEmit && oxlint src test && vitest run test/unit test/e2e",
    "worker": "node dist/worker.js"
  },
  "version": "0.1.0"
}
