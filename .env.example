# Copia este archivo a .env. Los valores sirven para desarrollo local con la infraestructura de docker compose.
# [obligatoria] la app falla al arrancar sin ella.
# [compose] docker compose la toma de .env; el resto las fija docker-compose.yml para la red interna.

# --- Aplicación ---
# [compose] development | test | production (en compose, production por defecto)
NODE_ENV=development
PORT=3000
# [compose] fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# [compose] URL pública usada en los enlaces de los correos de invitación
APP_PUBLIC_URL=http://localhost:3000

# --- Infraestructura ---
# [obligatoria]
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tickets-handler
# [obligatoria]
REDIS_URL=redis://localhost:6379
# [obligatoria]
ELASTICSEARCH_URL=http://localhost:9200
# Lista separada por comas
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=tickets-handler
KAFKA_GROUP_ID=tickets-handler-workers

# --- Autenticación ---
# [obligatoria] [compose] mínimo 32 caracteres; genera uno con: openssl rand -base64 48
JWT_SECRET=change-me-change-me-change-me-change-me
# [compose] duración del access token (15m, 1h, ...)
JWT_EXPIRES_IN=15m
# [compose]
REFRESH_TOKEN_TTL_DAYS=7
# [compose]
INVITATION_TTL_HOURS=24

# --- Administrador inicial (solo pnpm seed:admin y el servicio migrate) ---
# [obligatoria para el seed] [compose]
ADMIN_EMAIL=admin@example.com
# [obligatoria para el seed] [compose]
ADMIN_PASSWORD=change-me-admin-password

# --- Rate limiting ---
# [compose] peticiones permitidas por ventana
RATE_LIMIT_MAX=100
# [compose]
RATE_LIMIT_WINDOW_MS=60000

# --- Correo (Mailpit en local) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@tickets-handler.local

# --- Trazas (Jaeger en local) ---
OTEL_SERVICE_NAME=tickets-handler
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
